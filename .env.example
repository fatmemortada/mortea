# ─────────────────────────────────────────────────────────────────────────────
# Mortacc Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ── Django ──────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=generate-a-random-50-char-string-here
DEBUG=False
ALLOWED_HOSTS=mortacc.com,www.mortacc.com,mortacc.fly.dev
CSRF_TRUSTED_ORIGINS=https://mortacc.com,https://www.mortacc.com,https://mortacc.fly.dev
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_LOG_LEVEL=INFO

# ── Database ────────────────────────────────────────────────────────────────
# For Fly.io with SQLite (default), leave unset.
# For PostgreSQL, set to your connection string.
# DATABASE_URL=sqlite:///db.sqlite3

# ── Email (PrivateEmail / Namecheap) ────────────────────────────────────────
EMAIL_HOST_USER=support@mortacc.com
EMAIL_HOST_PASSWORD=your-email-password-here

# ── Site URL ────────────────────────────────────────────────────────────────
SITE_URL=https://www.mortacc.com

# ── Stripe ──────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=your-publishable-key-here
STRIPE_SECRET_KEY=your-secret-key-here
# Get this from Stripe Dashboard → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=your-webhook-signing-secret-here

# ── Stripe Price IDs ────────────────────────────────────────────────────────
# Create products/prices in Stripe Dashboard first, then paste the IDs here.
# https://dashboard.stripe.com/products

# Starter plan (5 bundles, monthly + yearly)
STRIPE_PRICE_STARTER_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_STARTER_ANNUAL=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Growth plan
STRIPE_PRICE_GROWTH_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_GROWTH_ANNUAL=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pro plan
STRIPE_PRICE_PRO_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO_ANNUAL=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Corporate plan
STRIPE_PRICE_CORPORATE_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_CORPORATE_ANNUAL=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Corporate Pro plan
STRIPE_PRICE_CORPORATEPRO_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_CORPORATEPRO_ANNUAL=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Fly.io ──────────────────────────────────────────────────────────────────
# Set automatically by Fly.io at deploy time — do not set locally.
# FLY_APP_NAME=mortacc

# AI document extraction (Claude API)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
